# Copy this file to keystore.properties in the project root (gitignored).
# Never commit keystore.properties, *.jks, or *.keystore.
#
# Generate an upload keystore: scripts/create-upload-keystore.ps1
# Or see README "Release signing".

STORE_FILE=release/upload-keystore.jks
STORE_PASSWORD=change-me
KEY_ALIAS=upload
KEY_PASSWORD=change-me
