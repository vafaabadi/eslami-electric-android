{
  "name": "eslami-electric-appium",
  "private": true,
  "version": "1.0.0",
  "description": "Appium 2 + WebdriverIO E2E tests for Eslami Electric Android",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:smoke": "wdio run wdio.conf.ts --spec ./specs/smoke.launch.spec.ts",
    "test:smoke:pr": "wdio run wdio.conf.ts --spec ./specs/smoke.launch.spec.ts --spec ./specs/navigation.tabs.spec.ts --spec ./specs/journey.core-catalog-to-basket.spec.ts",
    "test:ci": "wdio run wdio.conf.ts --spec ./specs/smoke.launch.spec.ts --spec ./specs/home.featured.spec.ts",
    "appium:install-driver": "appium driver install uiautomator2",
    "appium:doctor": "appium driver doctor uiautomator2",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.10.0",
    "@wdio/appium-service": "^8.40.6",
    "@wdio/cli": "^8.40.6",
    "@wdio/local-runner": "^8.40.6",
    "@wdio/mocha-framework": "^8.40.6",
    "@wdio/spec-reporter": "^8.40.6",
    "appium": "^2.12.1",
    "appium-uiautomator2-driver": "^3.8.0",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "webdriverio": "^8.40.6"
  }
}
