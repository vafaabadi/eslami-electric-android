# Copy to .env and fill in values. Never commit .env.

# --- Device / APK ---
# Android device / emulator (defaults target API 34 Pixel 7 AVD)
ANDROID_DEVICE_NAME=Pixel_7_API_34
ANDROID_PLATFORM_VERSION=14

# Path to debug APK (build with: cd .. && gradlew.bat assembleDebug)
APP_APK_PATH=../app/build/outputs/apk/debug/app-debug.apk

# Optional: reinstall app before each run
APP_REINSTALL=false

# --- API backend ---
# Debug APK defaults to http://10.0.2.2:3000 (emulator → host localhost:3000).
# Start cursor-my-web-app with `npm start` before E2E when using the default debug build.
# For production API on emulator/CI: gradlew assembleDebug -PapiBaseUrl=https://www.eslamielectric.com

# --- Auth (login / orders / profile / notifications) ---
# Required for: checkout.logged-in, profile.screen, order.detail, orders.my-orders,
# notifications.settings, account.logout, journey.core-auth-session, journey.logged-in-orders
# Use a dedicated QA test account — never production customer credentials.
TEST_EMAIL=
TEST_PASSWORD=

# --- Guest order lookup ---
# Required for: journey.core-guest-order-track, guest.track-email (full lookup path)
# Create a guest order via checkout on staging/production, then copy email + ORD- number.
TEST_GUEST_EMAIL=
TEST_ORDER_ID=

# --- Password reset deep link ---
# Required for: journey.forgot-reset-password (reset screen + submit)
# Obtain: trigger Forgot password for TEST_EMAIL, open reset link from email, copy token query param.
TEST_RESET_TOKEN=

# --- Claim guest account ---
# Required for: journey.claim-guest-account (full claim submit), journey.checkout-success-claim
# Obtain: complete guest checkout → success screen → Claim account → copy token from email/deep link.
TEST_CLAIM_TOKEN=
TEST_CLAIM_PASSWORD=

# --- Pending order edit ---
# Required for: journey.edit-pending-order, journey.core-checkout-pending-edit
# Obtain: place order as TEST_EMAIL, leave payment pending, copy order UUID from My orders or API.
TEST_PENDING_ORDER_ID=

# --- Catalog search ---
# Optional partial product search term (products.search-results.spec.ts defaults to "a")
SEARCH_TERM=

# --- Flaky / optional specs ---
# Set true to run permissions.notification.spec.ts (OS dialog; flaky on CI)
RUN_PERMISSION_SPEC=

# --- Appium server ---
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
