# Copy to .env and fill in values. Never commit .env.

# Android device / emulator (defaults target API 34 Pixel 7 AVD)
ANDROID_DEVICE_NAME=Pixel_7_API_34
ANDROID_PLATFORM_VERSION=14

# Path to debug APK (build with: cd .. && gradlew.bat assembleDebug)
APP_APK_PATH=../app/build/outputs/apk/debug/app-debug.apk

# Optional: reinstall app before each run
APP_REINSTALL=false

# Optional: use production API on emulator (release build). Debug build uses http://10.0.2.2:3000
# Start cursor-my-web-app with `npm start` before E2E when using debug APK.

# Auth E2E — specs skip automatically when unset:
# checkout.logged-in, profile.screen, order.detail, orders.my-orders,
# notifications.settings, account.logout
TEST_EMAIL=
TEST_PASSWORD=

# Optional guest order lookup E2E (future specs; not required for current suite)
TEST_GUEST_EMAIL=
TEST_ORDER_ID=

# Optional catalog search term (products.search-results.spec.ts defaults to "a")
SEARCH_TERM=

# Optional: run flaky notification-permission spec
RUN_PERMISSION_SPEC=

# Appium server (default localhost:4723)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
